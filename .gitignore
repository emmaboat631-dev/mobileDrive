# Claude Code session files
.claude/settings.local.json

# Local-only hero / gallery staging (regenerated by scripts)
scripts/.hero-staging/
scripts/.gallery-staging/

# 3D models — too large for GitHub (>100MB files rejected, repo bloat).
# Keep the README so the convention stays in version control, upload the
# actual .glb files to Supabase Storage before deploy.
public/models/*
!public/models/README.md
