# mobileDrive — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored, so secrets never leave your machine. Vars starting with
# NEXT_PUBLIC_ are inlined into the browser bundle; the rest only exist on
# the server. In production, set these in your host's environment panel
# (Vercel → Project → Settings → Environment Variables) and never commit
# live keys to git.

# ============================================================
# Required
# ============================================================

# ----- Supabase (database + auth) -----
# Grab from https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Used by webhook routes and admin
# server actions that need to write across users. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Site URL -----
# Base URL where this app is reachable. Used to build OAuth, email and
# payment-callback redirect URLs. Set to your production domain in prod
# (e.g. https://mobiledrive.app). http://localhost:3000 is fine in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Payments
# ============================================================

# ----- Paystack (Ghana payments) -----
# Grab from https://dashboard.paystack.com/#/settings/developers
# Use the TEST keys (sk_test_... / pk_test_...) until the launch cutover.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Static exchange rates for pricing USD/EUR vehicles in GHS at Paystack
# initialize time. Override with current mid-market rates. Defaults
# (15 GHS/USD, 16 GHS/EUR) ship for dev convenience.
PAYSTACK_FX_USD=15
PAYSTACK_FX_EUR=16

# ============================================================
# Email
# ============================================================

# ----- Resend (transactional emails) -----
# Grab from https://resend.com/api-keys
# When unset, email code logs to the console instead of sending — handy
# for local dev where you don't want to burn Resend quota.
RESEND_API_KEY=
# "From" address shown in the inbox. Use onboarding@resend.dev for quick
# testing, or a verified domain of yours (SPF/DKIM set up in Resend).
RESEND_FROM="mobileDrive <onboarding@resend.dev>"

# ============================================================
# Rate limiting
# ============================================================

# ----- Upstash Redis -----
# Sliding-window rate limiter for sign-in / sign-up / forgot-password.
# When unset, an in-memory limiter runs instead — fine for dev but NOT
# safe for production (resets per instance, doesn't scale). Create a
# free Redis DB at https://console.upstash.com and paste the REST URL +
# token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Observability (optional — enable when deploying)
# ============================================================

# ----- Sentry (errors + traces) -----
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
